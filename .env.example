# Variables d'environnement pour Vite
# =====================================
#
# NOTE: Les variables doivent commencer par VITE_ pour être exposées au client
# Les variables DEVKIT_VUE_* sont supportées via generateConfig

# Port de l'application (défini aussi dans src/config/defaults/*.cjs)
# VITE_PORT=8080

# API Configuration (ou utilisez DEVKIT_VUE_api_*)
# VITE_API_URL=http://localhost:3000
# VITE_API_BASE=api

# Analytics
# VITE_POSTHOG_HOST=
# VITE_POSTHOG_KEY=

# Variables DEVKIT personnalisées (via generateConfig)
# ===================================================
# Ces variables sont mergées dans la config générée (src/config/index.cjs)
# Syntaxe: DEVKIT_VUE_<chemin.vers.config>=valeur
#
# Exemples:
# DEVKIT_VUE_port=8080
# DEVKIT_VUE_api.protocol=https
# DEVKIT_VUE_api.host=api.example.com
# DEVKIT_VUE_api.port=443
# DEVKIT_VUE_sign.route=/dashboard
# DEVKIT_VUE_analytics.posthog.host=ph_instance_address
# DEVKIT_VUE_analytics.posthog.key=ph_project_api_key
