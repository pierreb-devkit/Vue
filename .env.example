# Variables d'environnement pour Vite
# =====================================
#
# NOTE: Les variables doivent commencer par VITE_ pour être exposées au client
# Les variables DEVKIT_VUE_* sont supportées via generateConfig

# Port de l'application (défini aussi dans src/config/defaults/*.cjs)
# VITE_PORT=8080

# API Configuration (ou utilisez DEVKIT_VUE_api_*)
# VITE_API_URL=http://localhost:3000
# VITE_API_BASE=api

# Analytics
# VITE_POSTHOG_HOST=
# VITE_POSTHOG_KEY=

# Variables DEVKIT personnalisées (via generateConfig)
# ===================================================
# Ces variables sont mergées dans la config générée (src/config/index.js)
# Syntaxe: DEVKIT_VUE_<path_to_config>=valeur (underscores map to nested keys)
#
# Exemples:
# DEVKIT_VUE_port=8080
# DEVKIT_VUE_api_protocol=https
# DEVKIT_VUE_api_host=api.example.com
# DEVKIT_VUE_api_port=443
# DEVKIT_VUE_sign_route=/dashboard
# DEVKIT_VUE_analytics_posthog_host=ph_instance_address
# DEVKIT_VUE_analytics_posthog_key=ph_project_api_key
